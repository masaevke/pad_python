# Заполните локально. Не коммитьте и не пересылайте файл с реальными секретами.
# Скачайте этот шаблон как .env и разместите рядом с pg2core_generator.py.
# Ранее заданные переменные окружения имеют приоритет над этим файлом.
# Значения рекомендуется заключать в одинарные кавычки; ${...} не подставляется.

# Прямое чтение метаданных PostgreSQL. При metadata_file эти поля не используются.
# PG_SOURCE_USER: например ваш разрешенный SQL-логин; пусто - текущий пользователь ОС.
PG_SOURCE_USER=''
# Пароль этого пользователя PostgreSQL; пусто - настроенная аутентификация libpq.
PG_SOURCE_PASSWORD=''

# API Dataflow. Заполните client_id/client_secret ИЛИ токен ниже.
# DATAFLOW_CLIENT_ID: например pd_core_dataflow, если доступ выдан этому клиенту.
DATAFLOW_CLIENT_ID=''
DATAFLOW_CLIENT_SECRET=''
# Альтернатива: Bearer-токен без префикса Bearer. Непустой токен имеет приоритет.
DATAFLOW_TOKEN=''

# ADB: обязательный логин и пароль пользователя, под которым выполняются DDL и гармонизатор.
# Пользователь ОС не подставляется. Пример логина: ваша разрешенная SQL-учетка ADB.
ADB_USER=''
# Пароль можно оставить пустым при настроенной аутентификации или adb_prompt_password=True.
ADB_PASSWORD=''
